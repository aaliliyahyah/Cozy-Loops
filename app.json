{
  "expo": {
    "name": "Cozy Loops",
    "slug": "Cozy-Loops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cozy-launcher.png",
    "scheme": "cozyloops",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/cozy-launcher.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF4E4",
        "foregroundImage": "./assets/images/cozy-launcher.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/cozy-launcher.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF4E4",
          "image": "./assets/images/cozy-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cozy Loops to attach photos to your crochet patterns.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
